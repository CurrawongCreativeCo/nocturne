{
  "name": "nocturne",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run typegen && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "brand-assets": "node scripts/build-studio-brand-assets.mjs",
    "editor-guide": "node scripts/build-editor-guide.mjs",
    "typegen": "npm run tokens && npm run brand-assets && sanity schema extract --path=./schema.json --enforce-required-fields --force && npm run editor-guide && sanity typegen generate",
    "typegen:watch": "sanity typegen generate --watch",
    "lint": "eslint . --max-warnings 0",
    "predev": "npm run tokens && npm run brand-assets && node scripts/setup/index.mjs",
    "setup": "node scripts/setup/index.mjs",
    "check:dataset": "node scripts/check-dataset.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:studio-brand": "node scripts/check-studio-brand.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "launch:screens": "node scripts/launch-screens.mjs",
    "release": "node scripts/release.mjs",
    "new:section": "node scripts/new-section.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "new:document": "node scripts/new-document.mjs",
    "new:singleton": "node scripts/new-singleton.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "hooks:on": "husky",
    "hooks:off": "git config --unset core.hooksPath",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test visual link-list-glass --update-snapshots --no-deps",
    "test:lighthouse": "lhci autorun",
    "studio-perf:seed": "node --experimental-strip-types tests/studio-perf/seed.ts",
    "studio-perf:build": "node --experimental-strip-types tests/studio-perf/server.ts",
    "studio-perf:serve": "node --experimental-strip-types tests/studio-perf/server.ts --serve",
    "test:studio-perf": "playwright test --config tests/studio-perf/playwright.config.ts"
  },
  "dependencies": {
    "@sanity/assist": "^6.2.4",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.8",
    "@sanity/vision": "^6.19.0",
    "@sentry/nextjs": "^10.76.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.1",
    "flags": "^4.3.1",
    "motion": "14.3.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.19.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "groq-js": "^2.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
