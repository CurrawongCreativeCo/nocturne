# Generated by `npm run config:docs` from the feature registries (src/app/feature-registry.ts).
# Do not edit it by hand: change the registry entry and regenerate. CI fails when it is stale.
# Copy it to .env.local. These are examples and empty slots, never real values. Every setting,
# where it goes and what it is for is in the README: "Configuration" → "Every setting".

# Sanity content: Connects the site and the Studio to their content.
# See README.md#deploying-vercel.
# Says which Sanity project holds the content. Get it from: sanity.io/manage → your project →
# Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
# Says which dataset in that project is this site. Default: None in the app. The GitHub workflows
# assume "production". Get it from: sanity.io/manage → your project → API → Datasets.
NEXT_PUBLIC_SANITY_DATASET="production"
# Lets the server read content. The site fails without it in every environment, whether the dataset
# is private or public; the build only starts to refuse a missing one from 1.11.0. Get it from:
# sanity.io/manage → your project → API → Tokens (Viewer role)
SANITY_API_READ_TOKEN=""

# Site address and language: Tells the site its public address, the language of its content and, in
# an emergency, to hide itself.
# Optional. An empty line means the default.
# See README.md#deploying-vercel.
# The site's public address, used in canonical links, the sitemap and structured data. Default:
# Vercel's production domain, then http://localhost:3000 in development. Get it from: The live
# address, for example https://example.com.au (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# The language of the content, for <html lang>, so screen readers pronounce it properly. Default:
# "en"
# NEXT_PUBLIC_SITE_LANGUAGE="en"

# Webhook mode (cache refresh on publish): Sanity tells the site when something is published,
# instead of every visitor holding a live connection open.
# Optional. An empty line means the default.
# See README.md#live-mode-vs-webhook-mode.
# Proves a publish notice came from Sanity. It must equal the webhook's secret, so it lives in two
# places. Default: Unset: live mode. Get it from: Generate one (for example openssl rand -hex 32)
# and enter it in Sanity and Vercel.
SANITY_REVALIDATE_SECRET=""

# Edge Config redirects: Answers the Studio's redirects before any page renders, from a map kept in
# Vercel Edge Config.
# Optional. An empty line means the default.
# See README.md#edge-config-redirects.
# The connection string the proxy reads redirects with. It contains a read token, so it is a secret;
# it also shows the store's id, which is how the site finds the store to write to. Default: Unset:
# the page route answers redirects. Get it from: Added by Vercel when you connect an Edge Config
# store to the project.
EDGE_CONFIG=""
# The store's ecfg_ id. Usually not needed: the site reads it from EDGE_CONFIG. Set it only if the
# connection string doesn't show one; if both are set they must name the same store, or nothing is
# written. Default: Derived from EDGE_CONFIG. Get it from: Vercel → Storage → your Edge Config →
# Settings, the id starting ecfg_.
EDGE_CONFIG_ID=""
# Lets a publish rewrite the redirects map. Only a team token can: a project-scoped token is refused
# (task 235). Whoever controls the site's runtime can use it on every project in that team, so this
# is not recommended; page-route redirects need no token. Default: Unset: the map is never written,
# and the page route answers redirects. Get it from: vercel.com/account/tokens, scoped to the team
# that owns the store.
VERCEL_API_TOKEN=""
# Needed only with a full-account token. A team token or a project-scoped token infers the team, and
# sending the id as well does no harm. Default: Unset: the token decides the team. Get it from:
# Vercel → team Settings → Team ID.
VERCEL_TEAM_ID=""

# Contact forms: Sends form submissions to your inbox, with a spam check.
# Optional. An empty line means the default.
# See README.md#forms-setup.
# Shows the spam check on the form. Public by design. Get it from: Cloudflare → Turnstile → your
# widget → Site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Lets the server confirm a visitor passed the spam check. Get it from: Cloudflare → Turnstile →
# your widget → Secret key.
TURNSTILE_SECRET_KEY=""
# Lets the server send each submission to your inbox. Get it from: Resend → API Keys.
RESEND_API_KEY=""
# The address submissions are sent from. Resend refuses a malformed or unverified one, so sending
# fails. Get it from: A sender verified in Resend, for example Site name <forms@example.com.au>.
FORMS_FROM_EMAIL=""

# Stored enquiries: Keeps each form submission as an enquiry the client reads in Studio, as well as
# emailing it.
# Optional. An empty line means the default.
# See README.md#enquiries.
# Switches on storing submissions. Set it to 1. Default: Unset: submissions are emailed only.
# ENQUIRIES_STORE="1"
# Lets the server write the enquiry document. The Stripe webhook and the publish gate use it too.
# Never give it a higher role than Editor. Get it from: sanity.io/manage → your project → API →
# Tokens (Editor role)
SANITY_WRITE_TOKEN=""

# Newsletter signup: Adds visitors to the client's mailing list from a signup section, with a spam
# check.
# Optional. An empty line means the default.
# See README.md#newsletter-signup.
# Also uses NEXT_PUBLIC_TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, RESEND_API_KEY, set above.
# Which service holds the list: resend, loops or mailchimp. Get it from: One of resend, loops or
# mailchimp.
NEWSLETTER_PROVIDER=""
# resend only: the segment new subscribers are added to. Default: Subscribers are added without a
# segment. Get it from: Resend dashboard → Segments.
NEWSLETTER_RESEND_SEGMENT_ID=""
# Needed when the provider is loops. Get it from: Loops → Settings → API.
LOOPS_API_KEY=""
# loops only: the mailing list new subscribers join. Default: Subscribers are added without a list.
LOOPS_MAILING_LIST_ID=""
# Needed when the provider is mailchimp. It ends in its datacentre, for example …-us21. Get it from:
# Mailchimp → Profile → Extras → API keys.
MAILCHIMP_API_KEY=""
# Needed when the provider is mailchimp: the audience subscribers join. Get it from: Mailchimp →
# Audience → Settings → Audience name and defaults.
MAILCHIMP_LIST_ID=""

# Pricing table and checkout: Shows prices from Stripe and sends buyers to Stripe to pay, then
# records the payment.
# Optional. An empty line means the default.
# See README.md#pricing-table.
# Also uses SANITY_WRITE_TOKEN, set above.
# Lets the server read prices and start a checkout. Get it from: Stripe → Developers → API keys (a
# restricted key is better than the secret key)
STRIPE_SECRET_KEY=""
# Proves a payment notice came from Stripe. It is the endpoint's signing secret, beginning whsec_.
# Get it from: Stripe → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=""
# Where buyers land after paying: a path or a full https:// URL. Default: /?checkout=success.
# STRIPE_SUCCESS_URL="/thanks"
# Where buyers go when they come back from Stripe without paying: a path or a full https:// URL.
# Default: The pricing page they came from.
# STRIPE_CANCEL_URL="/pricing"

# IndexNow (tell search engines about new pages): Pings participating search engines when a page or
# post is published.
# Optional. An empty line means the default.
# See README.md#indexnow.
# The key search engines check against the key file the site serves. Public by protocol, so it is
# not a secret. Default: Unset: no pings are sent. Get it from: Generate one, for example openssl
# rand -hex 16.
INDEXNOW_KEY=""

# Style guide on preview deployments: Opens the section gallery on a Vercel preview deployment with
# a token.
# Optional. An empty line means the default.
# See README.md#style-guide.
# Opens /section-gallery on a preview deployment. Never set it on Production, where the page is
# always a 404. Default: Unset: the style guide answers 404 on Vercel. Get it from: Generate one:
# openssl rand -hex 16 (16 or more characters)
STYLEGUIDE_PREVIEW_TOKEN=""

# Pre-launch preview access: Lets the team and the client see the whole site before launch, while
# visitors see a temporary page.
# Optional. An empty line means the default.
# See README.md#pre-launch-and-launch.
# Signs the preview pass that Presentation and the client link issue. Rotating it revokes every
# pass, by design. Default: Unset: no pass is ever valid and pre-launch pages stay private. Get it
# from: Generate one: openssl rand -hex 32 (16 or more characters)
PREVIEW_ACCESS_SECRET=""
# The client preview link's token. Anyone with the link has the same access as a pass. Default:
# Unset: there is no client link. Get it from: Generate one: openssl rand -hex 32 (16 or more
# characters)
PRELAUNCH_PREVIEW_TOKEN=""

# A/B tests: Shows some visitors a different version of a page and measures which one works better.
# Optional. An empty line means the default.
# See README.md#ab-tests-how-it-works.
# Signs the variant codes in prerendered URLs, so a visitor cannot forge one. Get it from: Generate
# one: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FLAGS_SECRET=""
# How long the proxy remembers whether a test is running, so starting or stopping one can take this
# long to show. Default: 60.
# EXPERIMENT_CACHE_SECONDS="60"

# Analytics and cookie consent: Loads Plausible, PostHog or Google Analytics after a visitor accepts
# analytics cookies.
# Optional. An empty line means the default.
# See README.md#analytics-and-cookie-consent.
# Turns on Plausible. Public, but whoever controls it receives visitor analytics. Get it from:
# Plausible → Site settings → the site's domain, for example example.com.au.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Turns on PostHog. Public, but whoever controls it receives visitor analytics. Get it from: PostHog
# → Project settings → Project token.
NEXT_PUBLIC_POSTHOG_KEY=""
# Which PostHog cloud receives events. Use https://eu.i.posthog.com for the EU cloud. Default:
# https://us.i.posthog.com.
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Turns on Google Analytics 4. Public, but whoever controls it receives visitor analytics. Get it
# from: Google Analytics → Admin → Data streams → Measurement ID (G-…)
NEXT_PUBLIC_GA_ID=""

# Members-only content: Lets chosen people sign in to see members-only pages and sections.
# Optional. An empty line means the default.
# See README.md#members-only-content.
# Signs the session cookie. Get it from: Generate one: openssl rand -base64 32.
AUTH_SECRET=""
# Turns on GitHub sign-in with AUTH_GITHUB_SECRET. One provider's pair is needed. Get it from:
# GitHub → Settings → Developer settings → OAuth Apps.
AUTH_GITHUB_ID=""
# The GitHub OAuth app's client secret. Get it from: GitHub → Settings → Developer settings → OAuth
# Apps.
AUTH_GITHUB_SECRET=""
# Turns on Google sign-in with AUTH_GOOGLE_SECRET. One provider's pair is needed. Get it from:
# Google Cloud console → APIs & Services → Credentials.
AUTH_GOOGLE_ID=""
# The Google OAuth client's secret. Get it from: Google Cloud console → APIs & Services →
# Credentials.
AUTH_GOOGLE_SECRET=""
# Who counts as a member: addresses and whole domains, comma-separated ("ann@example.com,
# @example.org"). An access list, so it stays here and not in Sanity. Default: Anyone who can sign
# in with an enabled provider.
AUTH_ALLOWED_EMAILS=""
# Needed when the site is not hosted on Vercel. Set it to true. Default: Unset: fine on Vercel.
# AUTH_TRUST_HOST="true"

# Error tracking (Sentry): Sends server and browser errors to Sentry, tagged with the reference
# shown on the error page.
# Optional. An empty line means the default.
# See README.md#error-tracking.
# Turns Sentry on. A DSN only lets events be sent, so it is public by design; the build copies it
# into the browser. Get it from: Sentry → Project settings → Client Keys (DSN)
SENTRY_DSN=""
# The share of requests traced, from 0 to 1. Default: 0.1.
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# Uploads source maps during the build only. Add it to the Vercel build environment, not .env.local.
# Default: Unset: no source maps are uploaded. Get it from: Sentry → Settings → Auth Tokens.
# SENTRY_AUTH_TOKEN=""
# The Sentry organisation the source maps belong to. Get it from: Sentry → Settings → Organization
# slug.
# SENTRY_ORG=""
# The Sentry project the source maps belong to. Get it from: Sentry → Project settings → Project
# slug.
# SENTRY_PROJECT=""

# Ops notices on Start here: Shows notices from the Ops dashboard on the Studio's Start here screen.
# Optional. An empty line means the default.
# See README.md#start-here-studio-home-screen.
# The https endpoint the notices come from. Default: Unset: the notices panel is skipped.
OPS_NOTICES_URL=""
# Sent to that endpoint as a bearer token from the server. It never reaches the browser.
OPS_NOTICES_KEY=""
