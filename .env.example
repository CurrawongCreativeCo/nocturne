# Public — safe to expose; inlined into client bundles.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-10-01"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: language of the content, for <html lang> (default "en").
NEXT_PUBLIC_SITE_LANGUAGE="en"
# Optional: name shown in the Studio header and browser tab (default "Content").
NEXT_PUBLIC_STUDIO_TITLE="Content"

# Server — Viewer-role token from sanity.io/manage → API → Tokens.
# Datasets are private, so the server reads published content with it too (README, "Dataset privacy").
# It reaches the browser only in draft mode, for the live preview connection.
SANITY_API_READ_TOKEN=""

# Optional — webhook mode for high-traffic sites (see README, "Webhook mode").
# Leave empty to use live updates. When set, visitors don't open live connections and
# Sanity calls /api/revalidate on publish instead. Use the same value as the webhook's secret.
SANITY_REVALIDATE_SECRET=""

# Optional — serve Studio redirects from Vercel Edge Config before pages render
# (see README, "Edge Config redirects"). Leave empty to redirect from the page route instead.
# EDGE_CONFIG is added to the project by Vercel when you connect an Edge Config store.
EDGE_CONFIG=""
EDGE_CONFIG_ID=""
VERCEL_API_TOKEN=""
# Only for team-owned stores.
VERCEL_TEAM_ID=""

# Optional — editor-built forms (see README, "Forms"). All four are needed to send mail; without
# them a form section shows a setup message in development and "unavailable" to visitors.
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile): the site key is public, the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Resend (resend.com → API Keys) and the verified sender, e.g. "Site name <forms@example.com>".
RESEND_API_KEY=""
FORMS_FROM_EMAIL=""
# Local testing only: replaces Turnstile and Resend with mocks that send nothing. Ignored on Vercel production.
# FORMS_TEST_MODE="1"

# Optional — newsletter signup section (see README, "Newsletter signup"). Needs the Turnstile keys above plus
# ONE provider: resend, loops or mailchimp. Resend reuses RESEND_API_KEY.
NEWSLETTER_PROVIDER=""
# resend: optional segment (Resend dashboard → Segments) to add subscribers to.
NEWSLETTER_RESEND_SEGMENT_ID=""
# loops: API key (Settings → API) and an optional mailing list id.
LOOPS_API_KEY=""
LOOPS_MAILING_LIST_ID=""
# mailchimp: API key ending in its datacenter, e.g. "…-us21", and the audience id (Audience → Settings).
MAILCHIMP_API_KEY=""
MAILCHIMP_LIST_ID=""

# Optional — pricing table backed by Stripe prices (see README, "Pricing table"). All server-side secrets.
# Stripe secret or restricted key (dashboard → Developers → API keys).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint <site>/api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=""
# Sanity token with the Editor role (sanity.io/manage → API → Tokens). Only the Stripe webhook writes with it.
SANITY_WRITE_TOKEN=""
# Where buyers land after paying / when they go back: a path or a full https:// URL.
# STRIPE_SUCCESS_URL="/thanks"
# STRIPE_CANCEL_URL="/pricing"

# Optional — IndexNow: tell search engines when a page is published (see README, "IndexNow").
# Needs webhook mode. 8-128 letters, digits and dashes, e.g. from `openssl rand -hex 16`.
INDEXNOW_KEY=""

# Optional — A/B tests with content variants (see README, "A/B tests"). Signs the variant codes in
# prerendered URLs. 32 random bytes, base64url: `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
# Without it no experiment runs and every visitor sees the published content.
FLAGS_SECRET=""
# How many seconds the proxy remembers whether an experiment is running (default 60).
# EXPERIMENT_CACHE_SECONDS="60"

# Optional — analytics (see README, "Analytics and cookie consent"). Each provider loads only after the
# visitor accepts analytics cookies. With none set, no cookie banner is shown. Vercel Analytics is always on and cookieless.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
# PostHog host (default the US cloud); use https://eu.i.posthog.com for the EU cloud.
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID=""

# Optional — members-only pages and sections (see README, "Members-only content"). AUTH_SECRET signs
# the session cookie: `openssl rand -base64 32`. Add a provider's id and secret to turn it on.
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Who counts as a member: addresses and whole domains, comma-separated ("ann@example.com, @example.org").
# Empty means anyone who can sign in with an enabled provider.
AUTH_ALLOWED_EMAILS=""
# Needed when not hosted on Vercel.
# AUTH_TRUST_HOST="true"
# End-to-end tests only: an email + password form that accepts that password. Ignored on Vercel production.
# AUTH_TEST_MODE="1"
# AUTH_TEST_PASSWORD=""

# Optional — Sentry error tracking (see README, "Error tracking"). Nothing loads without the DSN.
SENTRY_DSN=""
# Share of requests traced, 0 to 1 (default 0.1).
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# Source maps are uploaded during `next build` only when the auth token is set; set it as a CI secret, not in .env.local.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
