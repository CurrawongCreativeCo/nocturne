{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/e2e-server.mjs",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 300000,
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/about",
        "http://localhost:3100/hero-parts"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3100/$",
          "categories:performance": [
            "error",
            {
              "minScore": 0.9
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 1
            }
          ],
          "cumulative-layout-shift": [
            "error",
            {
              "maxNumericValue": 0.05
            }
          ],
          "largest-contentful-paint": [
            "error",
            {
              "maxNumericValue": 2500
            }
          ]
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/about$",
          "categories:performance": [
            "error",
            {
              "minScore": 0.9
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 1
            }
          ],
          "cumulative-layout-shift": [
            "error",
            {
              "maxNumericValue": 0.05
            }
          ],
          "largest-contentful-paint": [
            "error",
            {
              "maxNumericValue": 3000
            }
          ]
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/hero-parts$",
          "categories:performance": [
            "error",
            {
              "minScore": 0.9
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 1
            }
          ],
          "cumulative-layout-shift": [
            "error",
            {
              "maxNumericValue": 0.05
            }
          ],
          "largest-contentful-paint": [
            "error",
            {
              "maxNumericValue": 2500
            }
          ]
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
