  "seed": {
    "module": "scripts/setup/seed.mjs",
    "export": "seedDocuments",
    "import": "missing",
    "defaultProfile": "prelaunch-links",
    "marker": {
      "document": "siteIdentity",
      "field": "verificationMarker",
      "rule": "\"nocturne-\" plus the site name as a lowercase slug"
    },
    "profiles": [
      {
        "id": "prelaunch-links",
        "summary": "A published Link page, with Home and About as drafts, until launch.",
        "prelaunch": true,
        "published": [
          "siteIdentity",
          "siteNavigation",
          "designSettings",
          "announcement",
          "cookieBanner",
          "businessInfo",
          "page-links"
        ],
        "drafts": [
          "page-home",
          "page-about"
        ]
      },
      {
        "id": "full-site",
        "summary": "Home and About published, with menus, for a site that is live from the start.",
        "prelaunch": false,
        "published": [
          "siteIdentity",
          "siteNavigation",
          "designSettings",
          "announcement",
          "cookieBanner",
          "businessInfo",
          "page-home",
          "page-about"
        ],
        "drafts": []
      }
    ]
  },
  "verification": {
    "marker": {
      "meta": "nocturne:marker",
      "document": "siteIdentity",
      "field": "verificationMarker"
    },
    "siteInfo": {
      "path": "/api/site-info",
      "schema": 2,
      "statuses": [
        "prelaunch",
        "live"
      ]
    },
    "launchCheck": {
      "script": "scripts/launch-check.mjs",
      "args": [
        "--json"
      ],
      "prelaunchArg": "--prelaunch",
      "markerArg": "--expect-marker=",
      "env": [
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET"
      ],
      "passWhen": "summary.fail is 0"
    },
    "features": [
      {
        "id": "sanity-core",
        "checks": [
          "check-dataset"
        ]
      },
      {
        "id": "studio-brand",
        "checks": [
          "check-studio-brand"
        ]
      },
      {
        "id": "prelaunch",
        "checks": [
          "launch-check"
        ]
      },
      {
        "id": "health-monitoring",
        "checks": [
          "launch-check",
          "check-dataset"
        ]
      }
    ]
  }
