{
  "dots · mx-auto + class": "<div id="d" aria-hidden="true" data-decorative-divider="dots" class="my-6 flex max-w-full items-center text-line-strong w-fit gap-2 mx-auto mt-0"><span class="block size-1 rounded-full bg-current forced-colors:bg-[CanvasText]"></span><span class="block size-1 rounded-full bg-current forced-colors:bg-[CanvasText]"></span><span class="block size-1 rounded-full bg-current forced-colors:bg-[CanvasText]"></span></div>",
  "dots · plain": "<div id="d" aria-hidden="true" data-decorative-divider="dots" class="my-6 flex max-w-full items-center text-line-strong w-fit gap-2"><span class="block size-1 rounded-full bg-current forced-colors:bg-[CanvasText]"></span><span class="block size-1 rounded-full bg-current forced-colors:bg-[CanvasText]"></span><span class="block size-1 rounded-full bg-current forced-colors:bg-[CanvasText]"></span></div>",
  "fade · mx-auto + class": "<div id="d" aria-hidden="true" data-decorative-divider="fade" data-divider-centre="diamond" class="my-6 flex max-w-full items-center text-line-strong gap-3 w-max mx-auto mt-0"><span aria-hidden="true" class="block min-w-4 shrink-[4] h-px bg-linear-to-r from-transparent to-current forced-colors:bg-[CanvasText] w-28"></span><span class="flex max-w-[calc(100%-3.5rem)] min-w-0 shrink-0 items-center justify-center"><span aria-hidden="true" class="block shrink-0 rotate-45 size-1.5 bg-current forced-colors:bg-[CanvasText]"></span></span><span aria-hidden="true" class="block min-w-4 shrink-[4] h-px bg-linear-to-l from-transparent to-current forced-colors:bg-[CanvasText] w-28"></span></div>",
  "fade · plain": "<div id="d" aria-hidden="true" data-decorative-divider="fade" class="my-6 flex max-w-full items-center text-line-strong w-48"><span aria-hidden="true" class="block min-w-4 shrink-[4] h-px bg-linear-to-r from-transparent via-current to-transparent forced-colors:bg-[CanvasText] w-full"></span></div>",
  "line · mx-auto + class": "<div id="d" aria-hidden="true" data-decorative-divider="line" data-divider-centre="diamond" class="my-6 flex max-w-full items-center text-line-strong gap-3 w-max mx-auto mt-0"><span aria-hidden="true" class="block min-w-4 shrink-[4] h-px bg-current forced-colors:bg-[CanvasText] w-28"></span><span class="flex max-w-[calc(100%-3.5rem)] min-w-0 shrink-0 items-center justify-center"><span aria-hidden="true" class="block shrink-0 rotate-45 size-1.5 bg-current forced-colors:bg-[CanvasText]"></span></span><span aria-hidden="true" class="block min-w-4 shrink-[4] h-px bg-current forced-colors:bg-[CanvasText] w-28"></span></div>",
  "line · plain": "<div id="d" aria-hidden="true" data-decorative-divider="line" class="my-6 flex max-w-full items-center text-line-strong w-48"><span aria-hidden="true" class="block min-w-4 shrink-[4] h-px bg-current forced-colors:bg-[CanvasText] w-full"></span></div>",
}
`;

