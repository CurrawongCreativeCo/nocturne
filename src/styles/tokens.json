  "font": {
    "display": "var(--font-body)",
    "body": "var(--font-inter), ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
  },
  "type": {
    "display": {
      "size": "clamp(2.25rem, 9.375vw, 3.75rem)",
      "lineHeight": "1.05",
      "letterSpacing": "-0.025em"
    },
    "h1": {
      "size": "clamp(2.25rem, 1.125rem + 4.6875vw, 3rem)",
      "lineHeight": "1.1",
      "letterSpacing": "-0.025em"
    },
    "h2": {
      "size": "clamp(1.875rem, 1.3125rem + 2.34375vw, 2.25rem)",
      "lineHeight": "1.15",
      "letterSpacing": "-0.025em"
    },
    "h3": {
      "size": "clamp(1.375rem, 1.1875rem + 0.78125vw, 1.5rem)",
      "lineHeight": "1.25",
      "letterSpacing": "-0.025em"
    },
    "h4": {
      "size": "clamp(1.25rem, 1.25rem, 1.25rem)",
      "lineHeight": "1.4",
      "letterSpacing": "0"
    },
    "lead": {
      "size": "clamp(1.125rem, 1.125rem, 1.125rem)",
      "lineHeight": "1.55",
      "letterSpacing": "0"
    },
    "body": {
      "size": "clamp(1rem, 1rem, 1rem)",
      "lineHeight": "1.5",
      "letterSpacing": "0"
    },
    "small": {
      "size": "clamp(0.875rem, 0.875rem, 0.875rem)",
      "lineHeight": "1.43",
      "letterSpacing": "0"
    }
  },
  "space": {
    "section-y-compact": "4rem",
    "section-y": "6rem",
    "section-y-spacious": "clamp(8rem, 2rem + 25vw, 12rem)",
    "gutter": "1.5rem",
    "measure": "48rem",
    "measure-narrow": "42rem",
    "content": "80rem"
  },
  "radius": {
    "sm": "0.25rem",
    "control": "0.5rem",
    "card": "1rem",
    "panel": "1.5rem",
    "button": "9999px",
    "pill": "9999px"
  },
  "shadow": {
    "card": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "raised": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  },
  "emphasis": {
    "underline-thickness": "0.08em",
    "underline-offset": "0.14em",
    "highlight-strength": "0.22"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration": "300ms",
    "duration-slow": "600ms",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
    "reveal-distance": "24px"
  }
}
